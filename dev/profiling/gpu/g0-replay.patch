+/* ---- G0 throwaway (dev/profiling/gpu): record and replay filter outcomes ---- */
+#include <math.h>
+#include <time.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+typedef struct g0pair_s { float usc, vfsc, filtersc, fwdsc; } G0PAIR;
+extern int g0_mode;
+extern __thread G0PAIR *g0_cur;
+typedef struct { uint64_t h; int64_t v; } G0ENT;
+typedef struct { G0ENT *e; uint64_t mask; } G0HT;
+static G0HT     g0_qht, g0_tht;
+static int64_t  g0_nq = 0, g0_nt = 0, g0_ntcap = 0;
+static uint64_t *g0_qh = NULL, *g0_th = NULL;
+static G0PAIR  **g0_rows = NULL;
+static G0PAIR   *g0_data = NULL;
+static char     *g0_file = NULL;
+static __thread double g0_t_wait = 0., g0_t_search = 0.;
+
+static double g0_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + 1e-9 * t.tv_nsec; }
+static uint64_t g0_hash(const char *s) { uint64_t h = 1469598103934665603ULL; while (*s) { h ^= (unsigned char) *s++; h *= 1099511628211ULL; } return h ? h : 1; }
+static void g0_ht_init(G0HT *t, int64_t n) { uint64_t m = 16; while (m < (uint64_t) n * 2) m <<= 1; t->e = calloc(m, sizeof(G0ENT)); t->mask = m - 1; }
+static int64_t g0_ht_get(const G0HT *t, uint64_t h) { uint64_t i = h & t->mask; while (t->e[i].h) { if (t->e[i].h == h) return t->e[i].v; i = (i + 1) & t->mask; } return -1; }
+static void g0_ht_put(G0HT *t, uint64_t h, int64_t v) { uint64_t i = h & t->mask; while (t->e[i].h) { if (t->e[i].h == h) esl_fatal("G0: hash collision / duplicate name"); i = (i + 1) & t->mask; } t->e[i].h = h; t->e[i].v = v; }
+
+static void g0_dump(void)
+{
+  FILE *fp = fopen(g0_file, "wb");
+  uint64_t hdr[3] = { 0x4730524543ULL, (uint64_t) g0_nq, (uint64_t) g0_nt };
+  int64_t i;
+  fwrite(hdr, 8, 3, fp);
+  fwrite(g0_qh, 8, g0_nq, fp);
+  fwrite(g0_th, 8, g0_nt, fp);
+  for (i = 0; i < g0_nq; i++) fwrite(g0_rows[i], sizeof(G0PAIR), g0_nt, fp);
+  fclose(fp);
+  fprintf(stderr, "G0: recorded %ld queries x %ld targets\n", (long) g0_nq, (long) g0_nt);
+}
+
+static void g0_init(void)
+{
+  const char *m = getenv("HMMER_G0"), *f = getenv("HMMER_G0_FILE");
+  if (m == NULL) return;
+  g0_file = (char *) f;
+  if      (!strcmp(m, "record")) g0_mode = 1;
+  else if (!strcmp(m, "ctl"))    g0_mode = 2;
+  else if (!strcmp(m, "A"))      g0_mode = 3;
+  else if (!strcmp(m, "B"))      g0_mode = 4;
+  else esl_fatal("bad HMMER_G0");
+  if (g0_mode == 1)
+    {
+      g0_nt = 0; g0_ntcap = atol(getenv("HMMER_G0_NT"));
+      g0_ht_init(&g0_qht, 40000); g0_ht_init(&g0_tht, g0_ntcap);
+      g0_th = calloc(g0_ntcap, 8); g0_qh = calloc(40000, 8); g0_rows = calloc(40000, sizeof(G0PAIR *));
+      atexit(g0_dump);
+    }
+  else
+    {
+      double t0 = g0_now();
+      int fd = open(g0_file, O_RDONLY); struct stat st; uint64_t *hdr; char *map; int64_t i;
+      fstat(fd, &st);
+      map = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE | MAP_POPULATE, fd, 0);
+      hdr = (uint64_t *) map; g0_nq = hdr[1]; g0_nt = hdr[2];
+      g0_qh = (uint64_t *) (map + 24); g0_th = g0_qh + g0_nq; g0_data = (G0PAIR *) (g0_th + g0_nt);
+      g0_ht_init(&g0_qht, g0_nq); g0_ht_init(&g0_tht, g0_nt);
+      for (i = 0; i < g0_nq; i++) g0_ht_put(&g0_qht, g0_qh[i], i);
+      for (i = 0; i < g0_nt; i++) g0_ht_put(&g0_tht, g0_th[i], i);
+      fprintf(stderr, "G0: loaded %ld x %ld in %.3f s\n", (long) g0_nq, (long) g0_nt, g0_now() - t0);
+    }
+}
+
+static int g0_query(const char *name)
+{
+  uint64_t h = g0_hash(name); int64_t q = g0_ht_get(&g0_qht, h);
+  if (g0_mode == 1)
+    {
+      int64_t i;
+      if (q >= 0) esl_fatal("G0: query seen twice");
+      q = g0_nq++; g0_ht_put(&g0_qht, h, q); g0_qh[q] = h;
+      g0_rows[q] = malloc(sizeof(G0PAIR) * g0_ntcap);
+      for (i = 0; i < g0_ntcap; i++) g0_rows[q][i].usc = g0_rows[q][i].vfsc = g0_rows[q][i].filtersc = g0_rows[q][i].fwdsc = NAN;
+    }
+  else if (q < 0) esl_fatal("G0: query %s not in the record", name);
+  return (int) q;
+}
+
+static G0PAIR *g0_slot(int q, const char *name)
+{
+  uint64_t h = g0_hash(name); int64_t t = g0_ht_get(&g0_tht, h);
+  if (t < 0)
+    {
+      if (g0_mode != 1 || g0_nt >= g0_ntcap) esl_fatal("G0: target %s not in the record", name);
+      t = g0_nt++; g0_ht_put(&g0_tht, h, t); g0_th[t] = h;
+    }
+  return g0_mode == 1 ? &g0_rows[q][t] : &g0_data[(int64_t) q * g0_nt + t];
+}
+
