+static double X_passwall=0, X_busy=0, X_serial=0, X_lastend=0, X_tail=0, X_firstdone=0; static int X_npass=0, X_nact=0;
+static double X_wstart[256], X_wend[256]; static double X_read=0, X_qwait=0;
 
 #ifdef HMMER_THREADS
 /* Worker threads are created once and search one pass over the target
@@ -890,6 +894,8 @@ serial_master(ESL_GETOPTS *go, struct cfg_s *cfg)
     }
